# Copy to .env.production on the server and replace every placeholder.
# Generate random values with: openssl rand -hex 32

# Domain pointing at the server. Use :80 to try the stack over plain HTTP first.
DOMAIN=clinic.example.com

# PostgreSQL container. Use a hex password so it is safe inside the URL below.
POSTGRES_USER=clinic_app
POSTGRES_PASSWORD=change-this-password
POSTGRES_DB=medical_clinic

# Backend. The password must match POSTGRES_PASSWORD; the host is the "db" service.
CLINIC_APP_NAME=Medical Clinic Management
CLINIC_DATABASE_URL=postgresql+psycopg://clinic_app:change-this-password@db:5432/medical_clinic
CLINIC_TIMEZONE=Asia/Colombo
CLINIC_SECRET_KEY=change-this-secret
CLINIC_SESSION_EXPIRE_HOURS=12

# Initial accounts, created only if missing. Use strong passwords of 12+ characters.
CLINIC_ADMIN_USERNAME=admin
CLINIC_ADMIN_PASSWORD=change-this-password
CLINIC_DOCTOR_ONE_USERNAME=doctor1
CLINIC_DOCTOR_ONE_PASSWORD=change-this-password
CLINIC_DOCTOR_TWO_USERNAME=doctor2
CLINIC_DOCTOR_TWO_PASSWORD=change-this-password
