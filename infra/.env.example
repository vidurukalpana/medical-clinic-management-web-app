# Copy to infra/.env and fill in. Never commit infra/.env.
# Use an IAM user's access keys (with MFA), not the root account's.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1

DOMAIN_NAME=careflowclinic.net
# Receives alarm, GuardDuty and budget emails.
ALERT_EMAIL=you@example.com
MONTHLY_BUDGET_USD=100
