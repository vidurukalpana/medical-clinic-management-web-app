CLINIC_APP_NAME=Medical Clinic Management
CLINIC_DEBUG=true
CLINIC_DATABASE_URL=postgresql+psycopg://clinic_app:change-this-password@127.0.0.1:5432/medical_clinic
CLINIC_TIMEZONE=Asia/Colombo
CLINIC_HOST=127.0.0.1
CLINIC_PORT=8000
CLINIC_SESSION_EXPIRE_HOURS=12
CLINIC_ADMIN_USERNAME=admin
CLINIC_ADMIN_PASSWORD=adminpassword
CLINIC_DOCTOR_ONE_USERNAME=doctor1
CLINIC_DOCTOR_ONE_PASSWORD=doctor1password
CLINIC_DOCTOR_TWO_USERNAME=doctor2
CLINIC_DOCTOR_TWO_PASSWORD=doctor2password
CLINIC_CHATBOT_BASE_URL=http://127.0.0.1:11434
CLINIC_CHATBOT_MODEL=llama3.2:1b
CLINIC_CHATBOT_TIMEOUT_SECONDS=60
# Text messages to patients. "outbox" records them on the admin SMS outbox page without sending.
CLINIC_SMS_PROVIDER=outbox
CLINIC_SMS_WORKER_ENABLED=true
CLINIC_SMS_WORKER_INTERVAL_SECONDS=60
CLINIC_SMS_REMINDER_HOUR=7
CLINIC_SMS_REMINDER_HOURS_BEFORE=3
# Per-address request limits on login, registration, guest booking and the chat assistant.
CLINIC_RATE_LIMIT_ENABLED=true
CLINIC_TRUSTED_PROXY_IPS=127.0.0.1
# Demo doctor passwords for `python -m app.db.demo_data`, as JSON.
CLINIC_DEMO_DOCTOR_PASSWORDS={"demo.ayesha": "change-this-password", "demo.ruwan": "change-this-password", "demo.priya": "change-this-password", "demo.kasun": "change-this-password"}
