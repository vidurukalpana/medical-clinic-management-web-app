# Settings for `docker compose up`. Copy to .env.docker and replace every password.
# Account passwords need 12+ characters; the API refuses to start with these example values.

# Database container.
POSTGRES_USER=clinic_app
POSTGRES_PASSWORD=change-this-password
POSTGRES_DB=medical_clinic

# Backend. Use the same user, password and database as above; the host is the "db" service.
CLINIC_DATABASE_URL=postgresql+psycopg://clinic_app:change-this-password@db:5432/medical_clinic
CLINIC_TIMEZONE=Asia/Colombo
CLINIC_SESSION_EXPIRE_HOURS=12

# Initial accounts, created only if missing.
CLINIC_ADMIN_USERNAME=admin
CLINIC_ADMIN_PASSWORD=change-this-password
CLINIC_DOCTOR_ONE_USERNAME=doctor1
CLINIC_DOCTOR_ONE_PASSWORD=change-this-password
CLINIC_DOCTOR_TWO_USERNAME=doctor2
CLINIC_DOCTOR_TWO_PASSWORD=change-this-password

# Demo doctor passwords for `docker compose exec api python -m app.db.demo_data`, as JSON.
CLINIC_DEMO_DOCTOR_PASSWORDS={"demo.ayesha": "change-this-password", "demo.ruwan": "change-this-password", "demo.priya": "change-this-password", "demo.kasun": "change-this-password"}

# Chat assistant. This points at Ollama running on this computer.
# With `docker compose --profile chat up`, use http://ollama:11434 instead.
CLINIC_CHATBOT_BASE_URL=http://host.docker.internal:11434
CLINIC_CHATBOT_MODEL=llama3.2:1b
